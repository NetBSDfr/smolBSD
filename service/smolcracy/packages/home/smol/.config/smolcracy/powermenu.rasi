/* smolcracy powermenu — a dark rounded panel holding a row of icon
   tiles, the selected one light blue (adi1090x powermenu type-2 style
   4, laid out horizontally).  Icons are feather codepoints resolved
   via fontconfig from the bundled "feather" font; entries are glyphs
   mapped to actions.
   Note: the pkgsrc rofi 2.0.0 build ignores font in themes; the script
   passes -font on the command line instead. */
window {
	width: 700px;
	location: center;
	anchor: center;
	x-offset: 0;
	y-offset: 0;
	margin: 0;
	padding: 24px;
	spacing: 0;
	border: 0;
	border-radius: 22px;
	background-color: #181825;
}
mainbox {
	orientation: horizontal;
	children: [ listview ];
	margin: 0;
	padding: 0;
	spacing: 0;
	background-color: transparent;
}
listview {
	lines: 1;
	columns: 4;
	spacing: 16px;
	fixed-height: 0;
	dynamic: false;
	background-color: transparent;
}
element {
	font: "JetBrainsMono Nerd Font Mono 44";
	padding: 26px 0px 26px 48px;
	border-radius: 18px;
	background-color: #313244;
	text-color: #cdd6f4;
}
element-text {
	font: "JetBrainsMono Nerd Font Mono 44";
	background-color: transparent;
	text-color: inherit;
}
element selected {
	background-color: #89b4fa;
	text-color: #1e1e2e;
}
element selected-text {
	text-align: center;
	background-color: transparent;
	text-color: #1e1e2e;
}

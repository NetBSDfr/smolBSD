# smolcracy — slim status line, Omarchy-style "date time" right end.
# NOTE: pkgsrc i3status on NetBSD has no memory support (prints a
# warning every cycle), so cpu + clock it is.
general {
	output_format = "i3bar"
	colors = false
	interval = 5
}

order += "cpu_usage"
order += "tztime local"

cpu_usage { format = "cpu %usage" }
tztime local { format = "%a %d %b %H:%M" }

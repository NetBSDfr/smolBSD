! smolcracy — Omarchy catppuccin look for rxvt-unicode
URxvt.termName:		xterm-256color
# size= is POINTS: scales with Xft.dpi (9pt = 12px at 96dpi, 24px at
# the Retina 192).  pixelsize= would ignore Xft.dpi and stay tiny.
URxvt.font:		xft:monospace:size=9:antialias=true
URxvt.boldFont:		xft:monospace:size=9:antialias=true:weight=bold
URxvt.internalBorder:	10
URxvt.scrollStyle:	none
URxvt.cursorBlink:	false
URxvt.cursorColor:	#f5c2e7
URxvt.underlineColor:	#89b4fa
! catppuccin-mocha
URxvt.background:	[85]#1e1e2e
URxvt.foreground:	#cdd6f4
URxvt.color0:		#45475a
URxvt.color8:		#585b70
URxvt.color1:		#f38ba8
URxvt.color9:		#f38ba8
URxvt.color2:		#a6e3a1
URxvt.color10:		#a6e3a1
URxvt.color3:		#f9e2af
URxvt.color11:		#f9e2af
URxvt.color4:		#89b4fa
URxvt.color12:		#89b4fa
URxvt.color5:		#f5c2e7
URxvt.color13:		#f5c2e7
URxvt.color6:		#94e2d5
URxvt.color14:		#94e2d5
URxvt.color7:		#bac2de
URxvt.color15:		#a6adc8
URxvt.highlightColor:	#45475a
URxvt.highlightTextColor: #cdd6f4
URxvt.scrollBar: false
URxvt.depth:		32
# Xft.dpi is NOT pinned here: .xsession computes it per display
# (96 normally; 192 on native-panel Retina modes >=2400 wide, where
# the cocoa frontend maps fb pixels 1:1 to physical pixels) and merges
# it after this file.  A static pin here would clobber that.

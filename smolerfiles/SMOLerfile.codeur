# smol'd version of codeur https://codeberg.org/bapt/codeur
#
# codeur is a tiny and feature full AI coding agent in C: single binary,
# OpenAI-compatible APIs (Ollama, vLLM, DeepSeek, OpenAI), REPL with
# streaming markdown, tree-sitter highlighting, tools, sub-agents, MCP
# and persistent memory.
#
# no NetBSD binary release and no usable tag (0.2 is stale: it builds
# as 0.1.0 and fails on NetBSD with struct timeval undeclared in
# util.h), so the source is taken from the main branch archive. It is
# built with ./configure (bbuild) + make + make install, all from the
# comp set.
# The only required dependency is libcurl, located through pkg-config
# (pkgsrc curl); tree-sitter and the language parsers are vendored in
# deps/ and compiled in. The BSD functions codeur uses (arc4random_buf,
# strlcpy, strlcat, strtonum) are provided by NetBSD libc, so no libbsd
# is needed. universal-ctags speeds up codebase indexing but is not in
# the pkgsrc 11.0 repositories (wip only), so codeur uses its regex
# fallback for symbol indexing.
#
# codeur is written against C23 but compiles fine with the base gcc
# 12.5 of the comp set: it already understands [[nodiscard]] and
# [[maybe_unused]] (GCC 10/11), only nullptr, constexpr and the C23
# fixed underlying type of enums are missing (GCC 13). nullptr and
# constexpr are shimmed with -Dnullptr=NULL -Dconstexpr=const; a sed
# drops the "enum : int" fixed types and rewrites the file-scope
# constexpr of coordination.h / parse_tools.h to static const so they
# keep their C23 internal linkage (plain const would give duplicate
# definitions). libcurl lives in /usr/pkg/lib, outside the runtime
# linker's default search path, so the binary is linked with an
# rpath on it.
#
# configuration lives in ~/.config/codeur/config.ini (see upstream
# config.ini.sample: url, api_key, model in a [provider:...] section).
# Pass it from the host with a 9P share or fw_cfg, like maki:
#
# ./smoler.sh run codeur-amd64:latest -m 512 -w /path/to/configdir
# ./smoler.sh run codeur-amd64:latest -E codeurconf=/path/to/config.ini
#
# /path/to/configdir must contain config.ini (or .config/codeur/config.ini);
# a share/codeur/ subdirectory is copied over the config dir at boot to
# persist sessions and memory across reboots.
#
# without a config file, the CODEUR_API_URL / CODEUR_API_KEY / CODEUR_MODEL
# environment variables can be injected directly with -e:
#
# ./smoler.sh run codeur-amd64:latest -e CODEUR_API_URL=https://api.openai.com/v1/chat/completions -e CODEUR_API_KEY=sk-... -e CODEUR_MODEL=gpt-4o
#
# state (sessions, memory) lives in ~/.local/{state,share}/codeur inside
# the image and is lost on reboot unless persisted through the share.

FROM base,comp,etc

LABEL smolbsd.service=codeur
LABEL smolbsd.imgsize=2048
LABEL smolbsd.use_pty=y
LABEL revision="smol1"

ARG CODEUR_VERSION="main"
ARG CBREPO=https://codeberg.org/bapt/codeur/archive

ENV NBUSER=codeur
ENV LANG=en_US.UTF-8
ENV TERM=tmux-256color
ENV PATH=${PATH}:/usr/pkg/bin

RUN pkgin up && pkgin -y in curl pkg-config git-base ripgrep fd-find \
	bash rsync tmux vim

RUN cd /tmp && \
	curl -L -s -o codeur.tgz ${CBREPO}/${CODEUR_VERSION}.tar.gz && \
	tar zxf codeur.tgz && \
	cd codeur && \
	sed -i 's/^constexpr /static const /; s/enum *: *int/enum/g' src/*.c src/*.h && \
	./configure --prefix=/usr/pkg && \
	make CFLAGS="-O2 -Dnullptr=NULL -Dconstexpr=const" \
		LDFLAGS="-Wl,-rpath,/usr/pkg/lib" && \
	make install && \
	cd / && rm -rf /tmp/codeur /tmp/codeur.tgz

RUN cat <<EOF >/etc/rc.local
hostname ${NBUSER}
ulimit -n 4096
EOF

RUN echo 'eval \$(resize)' >>/etc/rc.local
RUN echo 'printf "\nℹ️ When shutting down, ${LIGHTGREEN}Ctrl-A Ctrl-X${NORMAL} to exit the microvm\n\n"' >>/etc/rc.local

USER $NBUSER
WORKDIR /home/$NBUSER

RUN touch .hushlogin

RUN cat <<EOF >.tmux.conf
set -g status off
set -g default-terminal "screen-256color"
set -g mode-keys vi
set -g set-clipboard on
set -g default-shell /usr/pkg/bin/bash
EOF

RUN cat <<EOF >.profile
cd /home/$NBUSER
LIGHTGREEN="\033[92m"
NORMAL="\033[0m"

if ! pgrep codeur >/dev/null 2>&1; then
	printf "\n\n🧩 \\\${LIGHTGREEN}codeur\\\${NORMAL} runs inside \\\${LIGHTGREEN}tmux\\\${NORMAL} with prefix \\\${LIGHTGREEN}^b\\\${NORMAL}\n"
	printf "\n⌨️  Press \\\${LIGHTGREEN}enter\\\${NORMAL} to start the session"
	read x
	printf "\n⌚ Wait for \\\${LIGHTGREEN}codeur\\\${NORMAL} to load...\n\n"

	codeur

	exit
fi
PS1="[\\w]\\\$ "
EOF

RUN cat <<EOF >cmd.sh
#!/bin/sh

for f in /mnt/config.ini \
	/mnt/.config/codeur/config.ini \
	/var/qemufwcfg/opt/org.smolbsd.file.codeurconf
do
	if [ -f "\\\$f" ]; then
		mkdir -p .config/codeur
		cp "\\\$f" .config/codeur/config.ini
		# reuse persisted state if the host share carries one
		[ -d "/mnt/share/codeur" ] && \
			cp -rf /mnt/share/codeur/* .config/codeur/
		chown -R $NBUSER /home/$NBUSER
		chmod 644 .config/codeur/config.ini
		exec su ${NBUSER} -c "tmux -u new"
	fi
done

if [ -n "\\\$CODEUR_API_URL" ] || [ -n "\\\$CODEUR_API_KEY" ]; then
	exec su ${NBUSER} -c "tmux -u new"
fi

printf "⚠️ no \\\${LIGHTGREEN}config.ini\\\${NORMAL} passed from the host, either:\n"
printf "\n- add \\\${LIGHTGREEN}-E codeurconf=/path/to/config.ini\\\${NORMAL} to the command line"
printf "\n- or copy config.ini to a directory and add \\\${LIGHTGREEN}-w /path/to/directory\\\${NORMAL}\n"
printf "\n- or pass \\\${LIGHTGREEN}-e CODEUR_API_URL=... -e CODEUR_API_KEY=...\\\${NORMAL} to run without a config file\n"
ksh
EOF
RUN chmod +x cmd.sh

CMD ./cmd.sh

# vim: filetype=dockerfile :

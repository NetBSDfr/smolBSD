# SMOLerfile.urbanterror — GLX-accelerated Xorg over virtio-gpu (virgl)
# running Urban Terror directly (no window manager): the ioquake3 engine
# starts windowed and the VM halts when the game exits.
#
# Requirements: same as SMOLerfile.xbase —
#  - kernel: SMOLX (startnb.sh -X picks kernels/amd64/smolbsdx, 2 GB RAM)
#  - sets/amd64/smolset.tar.xz (patched libdrm/libglapi/virtio_gpu_dri
#    from the supasmol tree; ./mksmolset.sh amd64 + copy from obj/)
#
# Run:
#   ./smoler.sh run urbanterror-amd64:latest -X -S

# smolset LAST: its patched libdrm/libglapi/virtio_gpu_dri must overwrite
# the official same-named files from the xbase set (extraction order =
# override order)
FROM base,etc,xbase,xserver,xetc,xfont,smolset

LABEL smolbsd.service=urbanterror
LABEL smolbsd.imgsize=6144
LABEL smolbsd.use_pty=y

RUN pkgin up && pkgin -y in urbanterror
# fontconfig's CONF_FILES merge does not happen through pkgin, so its
# default config must be placed by hand (SDL2 font rendering) — it is not
# in urbanterror's dependency closure, so the copy is best-effort
RUN mkdir -p /usr/pkg/etc/fonts && \
	cp /usr/pkg/share/examples/fontconfig/fonts.conf \
	/usr/pkg/etc/fonts/fonts.conf 2>/dev/null || true
# \$PATH stays literal: the generated postinst wraps RUN in double quotes
RUN printf '%s\n' 'export DISPLAY=:1' \
	'export PATH=\$PATH:/usr/X11R7/bin:/usr/pkg/bin' >> /etc/profile

# xorg.conf + session.sh live in service/urbanterror/etc/ and land in the
# image's /etc via mkimg's standard service-dir rsync

ENV LD_LIBRARY_PATH=/usr/X11R7/lib

CMD sh /etc/session.sh


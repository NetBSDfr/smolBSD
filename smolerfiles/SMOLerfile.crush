# smol'd version of crush https://github.com/charmbracelet/crush
#
# copy a configured crush.json in the directory of the
# project you want to work on and:
#
# ./smoler.sh run crush-amd64:latest -m 1024 -w /path/to/project
#
# /path/to/project will be mounted in /mnt
#
FROM base,comp,etc

LABEL smolbsd.service=crush
LABEL smolbsd.imgsize=2048
LABEL smolbsd.use_pty=y
LABEL revision="smol2"

ENV NBUSER=crush

INCLUDE smolerfiles/install-crush.inc

# passwordless doas (nbakery style). the user is created here, before
# agent.inc's USER step: the parser's USER handler skips useradd when the
# id already exists, and after that switch RUN commands run as the user,
# who could not usermod itself.
RUN pkgin -y in doas && useradd -m ${NBUSER} && \
	usermod -G wheel ${NBUSER} && \
	echo "permit nopass keepenv setenv { PATH } :wheel" > /usr/pkg/etc/doas.conf

INCLUDE smolerfiles/agent.inc

ARG CONF_FILES=/mnt/crush.json /var/qemufwcfg/opt/org.smolbsd.file.crush
ARG CONF_TARGET=crush.json
ARG CONF_NAME=crush.json
ARG CONF_VAR=crush
INCLUDE smolerfiles/agent-launch.inc

CMD ./cmd.sh

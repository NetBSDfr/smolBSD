# smol'd version of maki https://github.com/tontinton/maki
#
# the NetBSD release binary, its dependencies and the NetBSD build quirks
# live in smolerfiles/install-maki.inc (shared with SMOLerfile.agents).
#
# copy a configured maki init.lua in the directory of the
# project you want to work on and:
#
# ./smoler.sh run maki-amd64:latest -m 1024 -w /path/to/project
#
# /path/to/project will be mounted in /mnt
#
# the project's .maki/init.lua is picked up automatically by maki;
# to inject a global config instead, pass it with -E or -f etc:
#
# ./smoler.sh run maki-amd64:latest -E makiconf=/path/to/init.lua
#

FROM base,comp,etc

LABEL smolbsd.service=maki
LABEL smolbsd.imgsize=2048
LABEL smolbsd.use_pty=y
LABEL revision="smol4"

ENV NBUSER=maki

INCLUDE smolerfiles/install-maki.inc

INCLUDE smolerfiles/agent.inc

ARG CONF_FILES=/mnt/init.lua /mnt/.maki/init.lua /var/qemufwcfg/opt/org.smolbsd.file.makiconf
ARG CONF_TARGET=.config/maki/init.lua
ARG CONF_NAME=init.lua
ARG CONF_VAR=makiconf
ARG CONF_SHARE=/mnt/share/maki
ARG CONF_HINT=or drop a .maki/init.lua in the project (picked up by maki)
INCLUDE smolerfiles/agent-launch.inc

CMD ./cmd.sh


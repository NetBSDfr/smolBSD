# smol'd version of maki https://github.com/tontinton/maki
#
# maki is written in Rust (edition 2024, needs rust 1.88+) and there is
# no NetBSD binary in the releases, so it is built from source here.
# The build follows the FreeBSD port (devel/maki): a C toolchain plus
# rust-bin (prebuilt, no deps), openssl, perl, python (pyo3/monty),
# pkgconfig and git (cargo pulls the git dependencies: pydantic/monty
# and astral-sh/ruff).
#
# isahc's static-curl/static-ssl build curl and OpenSSL from source and
# forward cargo's jobserver to make; that breaks bmake (--jobserver-fds),
# so cargo runs with GNU make from /usr/pkg/gnu/bin (like USES=gmake).
#
# luau (via mlua) uses std::numeric_limits without including <limits>;
# GCC's libstdc++ does not provide it transitively, so force-include it
# for C++ files (CXXFLAGS only applies to .cpp, not the C parts).
#
# the libc crate does not bind nl_langinfo_l on netbsd even though the
# NetBSD libc provides it, so maki-ui/src/clock.rs is patched the same
# way it already is for apple: declare the symbol via extern "C".
#
# parallel cargo builds die at random crates with "could not execute
# process rustc ... (never executed)" (ENOENT), so build with
# CARGO_BUILD_JOBS=1 after a separate cargo fetch.

# copy a configured maki init.lua in the directory of the
# project you want to work on and:
#
# ./smoler.sh run maki-amd64:latest -m 1024 -w /path/to/project
#
# /path/to/project will be mounted in /mnt
#
# the project's .maki/init.lua is picked up automatically by maki;
# to inject a global config instead, pass it with -E or -f etc:
#
# ./smoler.sh run maki-amd64:latest -E makiconf=/path/to/init.lua
#
# NOTE: the cargo build of ~600 crates (30 tree-sitter grammars, luau
# jit, static curl/openssl) is heavy — build with at least:
#
# BUILDMEM=8192 BUILDCPUS=4 ./smoler.sh build smolerfiles/SMOLerfile.maki
#

FROM base,comp,etc

LABEL smolbsd.service=maki
LABEL smolbsd.imgsize=8192
LABEL smolbsd.use_pty=y
LABEL smolbsd.buildcpus=4
LABEL smolbsd.buildmem=8192
LABEL revision="smol1"

ARG MAKI_VERSION="0.5.6"

ENV NBUSER=maki
ENV LANG=en_US.UTF-8
ENV TERM=tmux-256color
ENV PATH=${PATH}:/usr/pkg/bin

RUN pkgin up && pkgin -y in curl git-base ripgrep fd-find gh bash rsync \
	tmux rust-bin openssl perl python pkgconfig gmake

RUN mkdir -p /usr/pkg/bin /usr/src && \
	curl -L -s -o- \
		https://github.com/tontinton/maki/archive/refs/tags/v${MAKI_VERSION}.tar.gz | \
		tar zxf - -C /usr/src --strip-components=1 maki-${MAKI_VERSION} && \
	cd /usr/src && sed -i.bak \
		-e 's/#\[cfg(target_vendor = "apple")\]/#[cfg(any(target_vendor = "apple", target_os = "netbsd"))]/' \
		-e 's/#\[cfg(not(target_vendor = "apple"))\]/#[cfg(not(any(target_vendor = "apple", target_os = "netbsd")))]/' \
		maki-ui/src/clock.rs && \
	cd /usr/src && PATH=/usr/pkg/gnu/bin:${PATH} CARGO_BUILD_JOBS=1 cargo fetch --locked && \
	cd /usr/src && PATH=/usr/pkg/gnu/bin:${PATH} CARGO_BUILD_JOBS=1 CXXFLAGS="-include limits" cargo build --release --locked && \
	install -o root -g wheel -m 755 target/release/maki /usr/pkg/bin/maki && \
	strip /usr/pkg/bin/maki && \
	rm -rf /usr/src /root/.cargo/registry 2>/dev/null

RUN echo -n "Built: " && maki --version

RUN cat <<EOF >/etc/rc.local
hostname ${NBUSER}
ulimit -n 4096
EOF

RUN echo 'eval \$(resize)' >>/etc/rc.local
RUN echo 'printf "\nℹ️ When shutting down, ${LIGHTGREEN}Ctrl-A Ctrl-X${NORMAL} to exit the microvm\n\n"' >>/etc/rc.local

USER $NBUSER
WORKDIR /home/$NBUSER

RUN touch .hushlogin

RUN cat <<EOF >.tmux.conf
set -g status off
set -g default-terminal "screen-256color"
set -g mode-keys vi
set -g set-clipboard on
set -g default-shell /usr/pkg/bin/bash
EOF

RUN cat <<EOF >.profile
cd /home/$NBUSER
if ! pgrep maki >/dev/null 2>&1; then
	printf "\n\n🪟 ${LIGHTGREEN}maki${NORMAL} runs inside ${LIGHTGREEN}tmux${NORMAL} with prefix ${LIGHTGREEN}^b${NORMAL}\n"
	printf "\n⌨️  Press ${LIGHTGREEN}enter${NORMAL} to start the session"
	read x
	printf "\n⌚ Wait for ${LIGHTGREEN}maki${NORMAL} to load...\n\n"

	maki

	exit
fi
PS1="[\\w]\$ "
EOF

RUN cat <<EOF >cmd.sh
#!/bin/sh

for f in /mnt/init.lua \
	/mnt/.maki/init.lua \
	/var/qemufwcfg/opt/org.smolbsd.file.makiconf
do
	if [ -f "\\\$f" ]; then
		mkdir -p .config/maki
		cp "$f" .config/maki/init.lua
		# fresh launch, populate config with own toml
		[ -d "/mnt/share/maki" ] && \
			cp -rf /mnt/share/maki/* .config/maki/
		chown -R $NBUSER /home/$NBUSER
		chmod 644 .config/maki/init.lua
		exec su ${NBUSER} -c "tmux -u new"
	fi
done

printf "⚠️ no ${LIGHTGREEN}init.lua${NORMAL} passed from the host, either:\n"
printf "\n- add ${LIGHTGREEN}-E makiconf=/path/to/init.lua${NORMAL} to the command line"
printf "\n- copy init.lua to a directory and add ${LIGHTGREEN}-w /path/to/directory${NORMAL}\n"
printf "\n- or drop a .maki/init.lua in the project (picked up by maki)\n"
ksh
EOF
RUN chmod +x cmd.sh

CMD ./cmd.sh

# vim: filetype=dockerfile :

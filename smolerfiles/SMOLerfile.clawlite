FROM base,etc

LABEL smolbsd.service="clawlite"
LABEL smolbsd.imgsize="1024"
LABEL smolbsd.minimize="y"
LABEL smolbsd.use_pty="y"
LABEL version="smol2"

ARG HOSTNAME=smolbsd
ARG USERSHELL=/usr/pkg/bin/zsh
ENV USERNAME=clawlite

# used by clawlite
ARG TARGET_HOME=/home/$USERNAME

RUN pkgin -y in zsh curl jq vim tmux doas python314 && \
	curl -o /usr/pkg/bin/claw -L \
		https://raw.githubusercontent.com/kilian-ai/claw/refs/heads/main/clawlite.sh && \
	chmod +x /usr/pkg/bin/claw && \
	curl -o- -L https://raw.githubusercontent.com/kilian-ai/claw/main/scripts/install-and-seed.sh|sh && \
	sed -i '/^OPENAI_BASE_URL=/d;/^MODEL_OPENAI=/d' \
		${TARGET_HOME}/.config/clawlite/config

RUN cat >${TARGET_HOME}/.zshrc<<_ZSHRC
export TERM=tmux-256color
PS1="%K{237}%F{yellow} %n@%m %F{white}%~ %K{black}%F{237}%k%f "
_ZSHRC

INCLUDE smolerfiles/usershell.inc

# passwordless doas (nbakery style); the user was created by usershell.inc
# and we're still root here, so it can be added to wheel
RUN usermod -G wheel ${USERNAME} && \
	echo "permit nopass keepenv setenv { PATH } :wheel" > /usr/pkg/etc/doas.conf

CMD login -f -p $USERNAME

# vim: filetype=dockerfile :

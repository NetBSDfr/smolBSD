# SMOLerfile.smolcracy — Omarchy-style keyboard-first X11 desktop:
# i3 + rofi + dunst + picom + rxvt-unicode, session running as user
# smol with passwordless doas to root.  Same GL stack as xbase
# (SMOLX kernel, virtiodrm/vioinput, virgl).  Look & feel clones the
# Omarchy catppuccin theme: Inter UI font, JetBrainsMono terminal,
# dark rounded windows, thin accent borders, top bar, corner notices.

# smolset LAST: its patched libdrm/libglapi/virtio_gpu_dri must overwrite
# the official same-named files from the xbase set (extraction order =
# override order)
FROM base,etc,xbase,xserver,xetc,xfont,smolset

LABEL smolbsd.service=smolcracy
LABEL smolbsd.imgsize=4096
LABEL smolbsd.use_pty=y

RUN pkgin up && pkgin -y in i3 i3status i3lock rxvt-unicode rofi \
	dunst picom maim hsetroot clipit xidle xdotool wmctrl btop \
	JetBrainsMono-ttf Inter-UI dejavu-ttf bash starship lsd doas nerd-fonts-JetBrainsMono nerd-fonts-symbols alacritty luakit adwaita-icon-theme
# fontconfig's CONF_FILES merge does not happen through pkgin, so its
# default config must be placed by hand (libXft font rendering)
RUN mkdir -p /usr/pkg/etc/fonts && \
	cp /usr/pkg/share/examples/fontconfig/fonts.conf \
	/usr/pkg/etc/fonts/fonts.conf
# dbus needs a machine-id for the session bus (dunst, notify-send);
# pkgsrc dbus looks in /var/lib/dbus and /etc, and none exists in a
# fresh smolBSD image, so write one from base uuidgen
RUN uuidgen | tr -d '-' > /etc/machine-id
# session user: wheel gives access to the device nodes, doas is
# NetBSD base, and 'permit nopass' grants passwordless root.  No -m:
# /home/smol already exists (it rides in via service packages/) and
# the skel files are not needed for an X session.
RUN echo /usr/pkg/bin/bash >> /etc/shells
RUN useradd -d /home/smol -G wheel -s /usr/pkg/bin/bash -c 'smolBSD user' smol && \
	usermod -s /usr/pkg/bin/bash root && \
	printf 'permit nopass smol\npermit nopass root as smol\n' > /etc/doas.conf && cp /etc/doas.conf /usr/pkg/etc/doas.conf || true
# config tree arrives via the service-dir packages/ rsync as root
RUN chown -R smol /home/smol
# clipit's colorful stock tray icon (gradients) is replaced with a plain
# white paperclip that reads correctly on the dark bar.  This must be a
# RUN step, not packages/: the packages/ rsync happens before pkgin
# installs clipit, which would overwrite the file again.  The viewBox is
# 24x24 and the glyph is scaled down so it sits slightly smaller than
# the bar status indicators.
RUN printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
	'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">' \
	'  <g transform="translate(4.1 4.1) scale(0.66)" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' \
	'    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>' \
	'  </g>' \
	'</svg>' > /usr/pkg/share/icons/hicolor/scalable/apps/clipit-trayicon.svg

# AI/agent stack: maki + crush, same release idiom as SMOLerfile.maki
# and SMOLerfile.crush (runtime uname -p keeps aarch64 builds working).
ARG MAKI_VERSION=0.7.0
ARG CRUSH_VERSION=0.99.0
ARG GHARCH=$(uname -p)
ARG CRUSH_ARCH=$(uname -p|sed 's/aarch64/arm64/')
RUN curl -L -s -o- https://github.com/tontinton/maki/releases/download/v${MAKI_VERSION}/maki-v${MAKI_VERSION}-${GHARCH}-unknown-netbsd.tar.gz | tar zxf - -C /usr/pkg/bin maki
RUN curl -L -s -o- https://github.com/charmbracelet/crush/releases/download/v${CRUSH_VERSION}/crush_${CRUSH_VERSION}_Netbsd_${CRUSH_ARCH}.tar.gz | tar zxf - -C /usr/pkg/bin --strip-components=1 crush_${CRUSH_VERSION}_Netbsd_${CRUSH_ARCH}/crush
ENV LD_LIBRARY_PATH=/usr/pkg/lib:/usr/X11R7/lib

CMD sh /etc/session.sh

